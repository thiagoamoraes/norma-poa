   "tipo": "inciso",
   "rotulo": "III –",
   "estados": [
    {
     "desde": 0,
     "texto": "a quantidade de exemplares ou de inserções, no caso de veiculação impressa; e",
     "situacao": "vigente",
     "origem": {
      "operacao": "promulgacao_original"
     }
    }
   ]
  },
  {
   "id": "art-1/inc-IV",
