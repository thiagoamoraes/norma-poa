     "texto": "o custo total da peça ou do anúncio ao erário municipal e o nome do órgão ou ente público do qual provém a verba de custeio;",
     "situacao": "vigente",
     "origem": {
      "operacao": "promulgacao_original"
     }
    }
   ]
  },
  {
